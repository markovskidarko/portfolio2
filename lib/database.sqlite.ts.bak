// ChangeInNAV operations
export const changeInNAVQueries = {
  upsert: (database: Database.Database) => database.prepare(`
    INSERT INTO ChangeInNAV (account_id, from_date, to_date, starting_value, ending_value, deposits_withdrawals, dividends, interest, commissions, withholding_tax, other_fees, twr, fx_rate_to_base)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    ON CONFLICT(account_id, from_date, to_date) DO UPDATE SET
      starting_value = excluded.starting_value,
      ending_value = excluded.ending_value,
      deposits_withdrawals = excluded.deposits_withdrawals,
      dividends = excluded.dividends,
      interest = excluded.interest,
      commissions = excluded.commissions,
      withholding_tax = excluded.withholding_tax,
      other_fees = excluded.other_fees,
      twr = excluded.twr,
      fx_rate_to_base = excluded.fx_rate_to_base,
      created_at = CURRENT_TIMESTAMP
  `),

  getByAccount: (database: Database.Database) => {
    const stmt = database.prepare(`
      SELECT from_date, to_date, starting_value, ending_value, deposits_withdrawals, dividends, interest, commissions, withholding_tax, other_fees, twr, fx_rate_to_base
      FROM ChangeInNAV
      WHERE account_id = ?
      ORDER BY to_date DESC
      LIMIT 1
    `);
    
    return {
      get: (accountId: string) => stmt.get(accountId),
    };
  },
};

// Live Prices operations
export const livePriceQueries = {
  upsert: (database: Database.Database) => database.prepare(`
    INSERT INTO live_prices (symbol, price, previous_close, previous_close_date, updated_at, source)
    VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP, ?)
    ON CONFLICT(symbol) DO UPDATE SET
      price = excluded.price,
      previous_close = excluded.previous_close,
      previous_close_date = excluded.previous_close_date,
      updated_at = CURRENT_TIMESTAMP,
      source = excluded.source
  `),

  /**
   * Drop a symbol's cached live price. Used when the latest Yahoo response is
   * stale for the current session (e.g. pre-market with no pre-market trade
   * yet) so consumers fall back to Holdings.mark_price instead of serving the
   * yesterday's-close value that was cached as "live".
   */
  invalidate: (database: Database.Database) => database.prepare(`
    DELETE FROM live_prices WHERE symbol = ?
  `),

  get: (database: Database.Database) => {
    const stmt = database.prepare(`
      SELECT symbol, price, previous_close, previous_close_date, updated_at, source
      FROM live_prices
      WHERE symbol = ?
    `);

    return {
      get: (symbol: string) => stmt.get(symbol) as {
        price: number;
        previous_close: number | null;
        previous_close_date: string | null;
        updated_at: string;
        source: string | null;
      } | undefined,
    };
  },

  getAll: (database: Database.Database) => database.prepare(`
    SELECT symbol, price, previous_close, previous_close_date, updated_at, source
    FROM live_prices
    ORDER BY symbol
  `),
};

/**
 * Sum external cash flows (deposits − withdrawals, FX-converted to USD) across
 * the given accounts within an inclusive date range. Used by Today/MTD/YTD
 * metric callers so contributions during the period aren't reported as P&L.
 *
 * @param accountIds  account IDs to include, or null for all accounts
 *                    (excluding HUNGARY_MIGRATION_HISTORY)
 * @param fromDate    inclusive lower bound, YYYY-MM-DD
 * @param toDate      inclusive upper bound, YYYY-MM-DD (defaults to today)
 */
export function sumContributionsUSD(
  database: Database.Database,
  accountIds: Set<string> | string[] | null,
  fromDate: string,
  toDate: string = new Date().toISOString().split('T')[0]
): number {
  let idList: string[];
  if (accountIds == null) {
    idList = (database
      .prepare(`SELECT id FROM Accounts WHERE id != 'HUNGARY_MIGRATION_HISTORY'`)
      .all() as Array<{ id: string }>).map((r) => r.id);
  } else {
    idList = Array.from(accountIds);
  }
  if (idList.length === 0) return 0;

  const placeholders = idList.map(() => '?').join(',');
  const depRows = database
    .prepare(
      `SELECT amount, fx_rate_to_base FROM Deposits
       WHERE account_id IN (${placeholders}) AND date >= ? AND date <= ?`
    )
    .all(...idList, fromDate, toDate) as Array<{ amount: number; fx_rate_to_base: number | null }>;
  const wdRows = database
    .prepare(
      `SELECT amount, fx_rate_to_base FROM Withdrawals
       WHERE account_id IN (${placeholders}) AND date >= ? AND date <= ?`
    )
    .all(...idList, fromDate, toDate) as Array<{ amount: number; fx_rate_to_base: number | null }>;

  let net = 0;
  for (const d of depRows) net += d.amount * (d.fx_rate_to_base ?? 1);
  for (const w of wdRows) net -= w.amount * (w.fx_rate_to_base ?? 1);
  return net;
}

/**
 * Backwards-compatible wrapper: net contributions for today only.
 */
export function sumTodayContributionsUSD(
  database: Database.Database,
  accountIds: Set<string> | string[] | null
): number {
  const todayStr = new Date().toISOString().split('T')[0];
  return sumContributionsUSD(database, accountIds, todayStr, todayStr);
}

// Settings operations
export const settingsQueries = {
  get: (database: Database.Database) => {
    const stmt = database.prepare(`
      SELECT key, value, updated_at
      FROM Settings
      WHERE key = ?
    `);
    
    return {
      get: (key: string) => stmt.get(key) as { value: string; updated_at: string } | undefined,
    };
  },

  set: (database: Database.Database) => database.prepare(`
    INSERT INTO Settings (key, value, updated_at)
    VALUES (?, ?, CURRENT_TIMESTAMP)
    ON CONFLICT(key) DO UPDATE SET
      value = excluded.value,
      updated_at = CURRENT_TIMESTAMP
  `),

  getAll: (database: Database.Database) => database.prepare(`
    SELECT key, value, updated_at
    FROM Settings
    ORDER BY key
  `),
};